# Copy to config.env and edit. config.env is git-ignored.

# --- Server side -------------------------------------------------------------

# Directory to export. Must be a real directory on a local volume.
# On an APFS external drive this is typically under /Volumes.
EXPORT_PATH="/Volumes/ClusterWD/nfs-export"

# Who may mount it. Pick EXACTLY ONE of the two forms below.
#
#   Subnet form  - ALLOWED_NETWORK + ALLOWED_MASK
#   Host form    - ALLOWED_HOSTS as a space-separated list
#
# Leaving both unset is a hard error: this script will not publish a
# world-readable export by accident.
ALLOWED_NETWORK="192.168.1.0"
ALLOWED_MASK="255.255.255.0"
#ALLOWED_HOSTS="10.0.0.11 10.0.0.12"

# Identity mapping.
#   mapall  - every client user is squashed to this identity (simplest, least surprising)
#   maproot - only remote root is remapped; other UIDs pass through
# Leave MAP_MODE empty to write no mapping option at all (UIDs pass through as-is).
MAP_MODE="mapall"
MAP_IDENTITY="nobody:nobody"

# Extra export options, space separated. Common ones:
#   -ro        export read-only
#   -alldirs   allow clients to mount subdirectories of the export
EXTRA_EXPORT_OPTS=""

# --- Client side -------------------------------------------------------------

NFS_SERVER="192.168.1.10"
MOUNT_POINT="/Users/Shared/nfs/cluster"

# 3 is the reliable default for a macOS-served export.
# See README "NFS version" before switching to 4.
NFS_VERS="3"

# resvport is required when mounting a macOS-served export.
MOUNT_OPTS="resvport,rw,hard,intr"

# --- Monitor daemon ----------------------------------------------------------

# Seconds between samples.
SAMPLE_INTERVAL="30"

# Where the daemon writes newline-delimited JSON samples.
METRICS_LOG="/usr/local/var/log/nfs-monitor/samples.ndjson"

# Optional. If set, each sample is also POSTed here as JSON.
# Leave empty to keep the daemon entirely local.
METRICS_ENDPOINT=""
